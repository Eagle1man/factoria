# FACTORIA & AI — конфигурация (dev). Скопировать в .env. Секреты не коммитить.

# --- Среда ---
ENV=dev                        # dev | pilot | production

# --- LLM (этап 5; по умолчанию отключён) ---
LLM_PROVIDER=none              # none | deepseek | ollama
ALLOW_EXTERNAL_API=false       # true — только осознанно (исходящий HTTPS к DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:35b       # thinking/reasoning для tool-calling отключать на стороне вызова
LLM_TIMEOUT_S=3

# --- OPC UA ---
OPCUA_ENDPOINT=opc.tcp://localhost:48400
OPCUA_NAMESPACE=urn:mfg:emulator
OPCUA_ENABLED=true             # false — backend без опроса (тесты/UI)
OPCUA_SECURITY=None            # None | Basic256Sha256_Sign | Basic256Sha256_SignAndEncrypt
OPCUA_ALLOW_REMOTE=false       # true — только осознанно (docs/security/ot-baseline.md)
# TLS: сертификаты python scripts/gen_certs.py
OPCUA_CERT=certs/opcua-server.cert.der
OPCUA_KEY=certs/opcua-server.key.der
OPCUA_CLIENT_CERT=certs/opcua-client.cert.der
OPCUA_CLIENT_KEY=certs/opcua-client.key.der
OPCUA_SERVER_CERT=certs/opcua-server.cert.der

# --- 1C (ADR-118: по умолчанию stub/read-only) ---
ONES_MODE=stub                 # stub | http | odata
ONES_HTTP_URL=

# --- Симулятор/цель ---
TARGET=opcua                   # opcua | satisfactory
SIMULATOR_POLL_INTERVAL_S=2

# --- БД ---
DATABASE_URL=sqlite+aiosqlite:///./data/factoria.db

# --- История тегов ---
TAG_HISTORY_RETENTION_H=72

# --- Автономия ---
AUTONOMY_MAX=A1                # A1 | A2
ALLOWED_WRITE_TARGETS=L1,L2,L3

# --- Auth ---
JWT_SECRET=dev-secret-change-me
JWT_TTL_MIN=60
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
WS_TICKET_TTL_S=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MIN=5

# --- Двойник ---
TWIN_SNAPSHOT_MINUTES=15       # 0 — отключить
