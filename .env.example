# FACTORIA & AI — пример окружения (dev, план B без Docker)
# Копировать в .env. Значения ниже — только для разработки.

# --- LLM ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
LLM_PROVIDER=local             # deepseek | local ; по умолчанию local, пока нет ключа
ALLOW_EXTERNAL_API=false       # true только осознанно, с записью в docs/decisions.md

# --- OPC UA ---
# Порт 4840 на машине разработки занят OPC UA LDS (процесс opcualds),
# поэтому локально 48400. В docker-compose — 4840 (ТЗ §4.1).
OPCUA_ENDPOINT=opc.tcp://localhost:48400
OPCUA_NAMESPACE=urn:mfg:emulator
OPCUA_ENABLED=true             # false — backend без эмулятора (тесты, UI-разработка)
OPCUA_SECURITY=None            # None только для dev; перед пилотом Basic256Sha256
OPCUA_ALLOW_REMOTE=false       # true — только осознанно, см. docs/security/ot-baseline.md

# --- Dev-пользователи (только ENV=dev) ---
DEV_DEFAULT_PASSWORD=dev-password

# --- 1С ---
ONES_MODE=stub                 # stub | http
ONES_HTTP_URL=

# --- Симулятор ---
TARGET=opcua                   # opcua | satisfactory
SIMULATOR_POLL_INTERVAL_S=2

# --- БД ---
DATABASE_URL=sqlite+aiosqlite:///./data/factoria.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/factoria

# --- Хранение истории тегов ---
TAG_HISTORY_RETENTION_H=72     # без ретенции SQLite растёт на гигабайты за сутки

# --- Автономность ---
# A1 — любое действие через подтверждение человека.
# A2 — разрешить автономию в границах §6.4 (только set_setpoint).
AUTONOMY_MAX=A1                # A1 | A2
ALLOWED_WRITE_TARGETS=L1,L2,L3 # allowlist целей записи (EXT-2)

# --- Auth ---
JWT_SECRET=dev-secret-change-me
JWT_TTL_MIN=60
# При ENV != dev сервис обязан отказаться стартовать с дефолтным JWT_SECRET.

# --- Двойник ---
TWIN_SNAPSHOT_MINUTES=15       # снимок истории двойника; 0 — выключить

# --- Среда ---
ENV=dev                        # dev | pilot | production
