// GET /hs/mfg/orders/open
Функция СписокОткрытыхЗаказов(Запрос) Экспорт

    Результат = Новый Структура("orders", Новый Массив);

    Запрос1 = Новый Запрос;
    Запрос1.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 200
    |   Док.Номер КАК order_id,
    |   Док.Партнер КАК product,
    |   1 КАК qty,
    |   ""normal"" КАК priority,
    |   Док.Дата КАК due_date,
    |   ""SPEC-01"" КАК spec_id
    |ИЗ
    |   Документ.ЗаказКлиента КАК Док
    |ГДЕ
    |   НЕ Док.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |   Док.Дата";

    // TODO: заменить таблицу, поля количества/приоритета/спецификации
    // на реальные метаданные вашей конфигурации.

    Выборка = Запрос1.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Строка = Новый Структура;
        Строка.Вставить("order_id", Строка(Выборка.order_id));
        Строка.Вставить("product",  Строка(Выборка.product));
        Строка.Вставить("qty",      Число(Выборка.qty));
        Строка.Вставить("priority", Строка(Выборка.priority));
        Строка.Вставить("due_date", Формат(Выборка.due_date, "ДФ=yyyy-MM-dd"));
        Строка.Вставить("spec_id",  Строка(Выборка.spec_id));
        Результат.orders.Добавить(Строка);
    КонецЦикла;

    Возврат ОтветJSON(200, Результат);

КонецФункции

// GET /hs/mfg/orders/{order_id}
Функция ПолучитьЗаказ(Запрос) Экспорт

    Номер = Запрос.ПараметрыURL.Получить("order_id");

    Запрос1 = Новый Запрос;
    Запрос1.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Док.Номер КАК order_id,
    |   Док.Партнер КАК product,
    |   1 КАК qty,
    |   ""normal"" КАК priority,
    |   Док.Дата КАК due_date,
    |   ""SPEC-01"" КАК spec_id
    |ИЗ
    |   Документ.ЗаказКлиента КАК Док
    |ГДЕ
    |   Док.Номер = &Номер";
    Запрос1.УстановитьПараметр("Номер", Номер);

    Выборка = Запрос1.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда
        Возврат ОтветJSON(404, Новый Структура("error", "заказ не найден"));
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("order_id", Строка(Выборка.order_id));
    Результат.Вставить("product",  Строка(Выборка.product));
    Результат.Вставить("qty",      Число(Выборка.qty));
    Результат.Вставить("priority", Строка(Выборка.priority));
    Результат.Вставить("due_date", Формат(Выборка.due_date, "ДФ=yyyy-MM-dd"));
    Результат.Вставить("spec_id",  Строка(Выборка.spec_id));

    Возврат ОтветJSON(200, Результат);

КонецФункции

// POST /hs/mfg/plan — заглушка до отдельного ADR
Функция ЗаписатьПлан(Запрос) Экспорт
    Возврат ОтветJSON(501, Новый Структура("error", "запись плана не поддерживается"));
КонецФункции

// ---------------------------------------------------------------------
// Вспомогательная функция
// ---------------------------------------------------------------------
Функция ОтветJSON(Код, Данные) Экспорт

    ЗаписьJSON = Новый ЗаписьJSON;
    ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
    СтрокаJSON = "";
    ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
    ЗаписатьJSON(ЗаписьJSON, Данные);
    СтрокаJSON = ЗаписьJSON.Закрыть();

    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
    Возврат Ответ;

КонецФункции
